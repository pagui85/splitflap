# M5Stack Unit PoE-P4 (U213), mainboard schematic V0.2, early P4 silicon.
# Load after sdkconfig.defaults and sdkconfig.p4-early. See docs/ESP_IDF_U213_BRINGUP.md.
CONFIG_BRINGUP_BOARD_U213=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.5.0"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Keep the generic P4 PSRAM probe at the owner-tested 20 MHz. ESP-IDF detects
# the fitted 32 MiB in-package part at boot and keeps allocations internal.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ETH_USE_ESP32_EMAC=y
# CONFIG_ETH_USE_SPI_ETHERNET is not set
CONFIG_BRINGUP_ETHERNET=y
# IP101GRI (driver 3), R47 straps AD0 high and R46 straps AD3 low.
CONFIG_BRINGUP_ETH_PHY=3
CONFIG_BRINGUP_ETH_PHY_ADDR=1
CONFIG_BRINGUP_ETH_PHY_RESET=51
CONFIG_BRINGUP_ETH_MDC=31
CONFIG_BRINGUP_ETH_MDIO=52
# The PHY drives 50 MHz from its 25 MHz crystal, into the MAC on GPIO50.
CONFIG_BRINGUP_ETH_CLK_IN=50
CONFIG_BRINGUP_ETH_CLK_OUT=-1
CONFIG_BRINGUP_ETH_TX_EN=49
CONFIG_BRINGUP_ETH_TXD0=34
CONFIG_BRINGUP_ETH_TXD1=35
CONFIG_BRINGUP_ETH_CRS_DV=28
CONFIG_BRINGUP_ETH_RXD0=29
CONFIG_BRINGUP_ETH_RXD1=30
