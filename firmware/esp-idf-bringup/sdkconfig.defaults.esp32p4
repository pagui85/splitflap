# ESP-IDF v5.5.6 produces separate early and v3.x images. This is the v3.x profile.
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# P4's in-package memory uses the dedicated MSPI interface. The driver probes
# capacity and logs errors. Application and network allocations stay internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_20M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# IDF aborts on a boot memory-test failure even with IGNORE_NOTFOUND.
# CONFIG_SPIRAM_MEMTEST is not set
# CONFIG_BRINGUP_ETHERNET is not set
